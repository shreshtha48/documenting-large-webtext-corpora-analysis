reproduction/paper_figures/*.png
logs_*.txt
# ...except demographic bias (§4.3), whose runs are final: scores, analyses, figures, Kaggle logs
!reproduction/demographic_bias/results/
!reproduction/demographic_bias/results/**/logs/logs_*.txt
# ...and the summary figures for the brief (reproduction/results/ is caught by the rule above)
!reproduction/results/

# Upload bundles for Colab / Kaggle (rebuilt from the folders)
